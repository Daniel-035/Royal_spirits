generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String      @id @default(uuid())
  name        String
  category    String
  brand       String
  volumeMl    Int
  price       Float
  stockQty    Int         @default(0)
  imageUrl    String?
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]

  @@map("products")
}

model Customer {
  id           String            @id @default(uuid())
  phone        String            @unique
  name         String?
  email        String?           @unique
  passwordHash String?
  createdAt    DateTime          @default(now())
  addresses    CustomerAddress[]
  orders       Order[]

  @@map("customers")
}

model CustomerAddress {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  addressLine String
  pincode     String
  isDefault   Boolean  @default(false)

  @@map("customer_addresses")
}

model Order {
  id              String      @id @default(uuid())
  customerId      String
  customer        Customer    @relation(fields: [customerId], references: [id])
  customerName    String
  phone           String
  source          String      @default("WEB")
  status              String      @default("Ordered")
  paymentType         String      @default("Cash")
  paymentStatus       String      @default("Unpaid")
  deliveryAddress     String
  pincode             String
  subtotal            Float
  deliveryCharge      Float       @default(0)
  totalAmount         Float
  ageConfirmed        Boolean
  tncAccepted         Boolean
  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?
  paidAt              DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  items               OrderItem[]

  @@index([status])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  itemName  String
  quantity  Int
  unitPrice Float

  @@map("order_items")
}

model Admin {
  id            String   @id @default(uuid())
  username      String   @unique
  passwordHash  String
  businessName  String?
  licenseNumber String?
  shopAddress   String?
  phone         String?
  createdAt     DateTime @default(now())

  @@map("admins")
}

model ServiceableZone {
  id                  String   @id @default(uuid())
  pincode             String   @unique
  deliveryStartTime   String
  deliveryEndTime     String
  deliveryWindowMins  Int      @default(90)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("serviceable_zones")
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("otp_codes")
}

model WhatsAppSession {
  id          String   @id @default(uuid())
  phone       String   @unique
  state       String   @default("GREETING")
  contextJson String   @default("{}")
  cartJson    String   @default("[]")
  customerName String?
  handoffToAdminId String?
  lastIntentAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phone])
  @@map("whatsapp_sessions")
}

model WhatsAppEventLog {
  id          String   @id @default(uuid())
  waMessageId String   @unique
  fromPhone   String
  direction   String
  type        String
  payloadJson String
  createdAt   DateTime @default(now())

  @@index([fromPhone])
  @@map("whatsapp_event_log")
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String
  token     String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_resets")
}
