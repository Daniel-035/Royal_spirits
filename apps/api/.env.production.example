# Production environment for Royal Spirits API
# Copy to .env.production and fill in real values.
# NEVER commit the real .env.production file.

PORT=4000
NODE_ENV=production

# ===== DATABASE =====
# From Railway/Render/Supabase PostgreSQL dashboard
DATABASE_URL="postgresql://user:password@host:5432/royal_spirits?sslmode=require"

# ===== AUTH =====
# Generate with: openssl rand -base64 32
JWT_SECRET="generate-a-strong-random-secret-here"
JWT_EXPIRES_IN="7d"
ADMIN_COOKIE_NAME="rs_admin"
CUSTOMER_COOKIE_NAME="rs_cust"
# Your domain with leading dot for subdomain cookie sharing
COOKIE_DOMAIN=".yourdomain.com"
# Must be true in production (HTTPS)
COOKIE_SECURE=true

# ===== SEEDED ADMIN =====
# Change from default before launch
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-to-a-strong-password"

# ===== COMPLIANCE =====
# Your actual excise license number (shown in footer)
EXCISE_LICENSE_NUMBER="your-real-license-number"

# ===== CORS =====
# Comma-separated: your deployed frontend URLs
CORS_ORIGINS="https://shop.yourdomain.com,https://admin.yourdomain.com"

# ===== OTP PROVIDER =====
# Options: "mock" (dev only), "twilio", "msg91"
OTP_PROVIDER="twilio"

# --- Twilio credentials (from twilio.com console) ---
OTP_TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
OTP_TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# The phone number you bought in Twilio (with country code)
OTP_TWILIO_FROM="+1234567890"

# --- MSG91 credentials (from msg91.com dashboard) ---
# Only needed if OTP_PROVIDER="msg91"
OTP_MSG91_AUTH_KEY=""
OTP_MSG91_SENDER_ID="RSPIRT"
OTP_MSG91_TEMPLATE_ID=""

# ===== IMAGE STORAGE =====
# Options: "local" (dev only), "cloudinary"
IMAGE_PROVIDER="cloudinary"

# --- Cloudinary credentials (from cloudinary.com dashboard) ---
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="abc123def456ghi789jkl012mno345pqr678"

# ===== WHATSAPP (for order status notifications) =====
# Options: "mock" (dev only), "cloud_api" (Meta WhatsApp Business)
WHATSAPP_PROVIDER="mock"
# From Meta for Developers → WhatsApp Business API dashboard
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ID=""
WHATSAPP_API_VERSION="v18.0"

# ===== IMAGE UPLOAD (local provider only, ignored in cloudinary mode) =====
IMAGE_UPLOAD_DIR="uploads"
IMAGE_PUBLIC_BASE="/uploads"
