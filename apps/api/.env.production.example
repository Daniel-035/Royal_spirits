# Production environment template for Royal Spirits API
# Copy to .env.production and fill in real values.

PORT=4000
NODE_ENV=production

# Database — use PostgreSQL in production
DATABASE_URL="postgresql://user:password@host:5432/royal_spirits"

# Auth
JWT_SECRET="generate-a-strong-random-secret-here"
JWT_EXPIRES_IN="7d"
ADMIN_COOKIE_NAME="rs_admin"
CUSTOMER_COOKIE_NAME="rs_cust"
COOKIE_DOMAIN=".yourdomain.com"
COOKIE_SECURE=true

# Seeded admin credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"

# Compliance
EXCISE_LICENSE_NUMBER="your-real-license-number"

# CORS — your deployed frontend origins
CORS_ORIGINS="https://shop.yourdomain.com,https://admin.yourdomain.com"

# External service providers — use real providers in production
OTP_PROVIDER="twilio"
OTP_TWILIO_ACCOUNT_SID="ACxxxxxxxxx"
OTP_TWILIO_AUTH_TOKEN="your-twilio-auth-token"
OTP_TWILIO_FROM="+1234567890"

IMAGE_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
