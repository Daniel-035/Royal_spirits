# Server
PORT=4000
NODE_ENV=development

# Database — SQLite for local dev (file is created at apps/api/dev.db).
# For Postgres: set provider to "postgresql" in prisma/schema.prisma and use:
# DATABASE_URL="postgresql://royal:royal@localhost:5432/royal_spirits"
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="dev-only-change-me-in-production"
JWT_EXPIRES_IN="7d"
ADMIN_COOKIE_NAME="rs_admin"
CUSTOMER_COOKIE_NAME="rs_cust"
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Seeded admin credentials (used by prisma/seed.ts)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Compliance
EXCISE_LICENSE_NUMBER="L-EXCISE-00000"

# CORS — comma-separated origins
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# External service providers (dev uses mocks)
OTP_PROVIDER="mock"
OTP_MSG91_AUTHKEY=
OTP_TWILIO_ACCOUNT_SID=
OTP_TWILIO_AUTH_TOKEN=
OTP_TWILIO_FROM=

IMAGE_PROVIDER="local"
IMAGE_UPLOAD_DIR="uploads"
IMAGE_PUBLIC_BASE="/uploads"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
