# Development environment for Royal Spirits API
# Copy to .env and fill in values. Dev defaults to mock services.

PORT=4000
NODE_ENV=development

# Database — SQLite for local dev (file is created automatically)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="dev-only-change-me-in-production"
JWT_EXPIRES_IN="7d"
ADMIN_COOKIE_NAME="rs_admin"
CUSTOMER_COOKIE_NAME="rs_cust"
COOKIE_SECURE=false

# Seeded admin credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# Compliance
EXCISE_LICENSE_NUMBER="L-EXCISE-00000"

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# OTP — mock logs code to console; set to twilio/msg91 for real testing
OTP_PROVIDER="mock"
OTP_TWILIO_ACCOUNT_SID=""
OTP_TWILIO_AUTH_TOKEN=""
OTP_TWILIO_FROM=""
OTP_MSG91_AUTH_KEY=""
OTP_MSG91_SENDER_ID="RSPIRT"
OTP_MSG91_TEMPLATE_ID=""

# Images — local writes to uploads/; set to cloudinary for real testing
IMAGE_PROVIDER="local"
IMAGE_UPLOAD_DIR="uploads"
IMAGE_PUBLIC_BASE="/uploads"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# WhatsApp — mock logs to console
WHATSAPP_PROVIDER="mock"
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ID=""
WHATSAPP_API_VERSION="v18.0"

# LLM — mock returns canned intents (no API key needed).
# Set to "gemini" and provide GEMINI_API_KEY for free-tier Google Gemini 2.0 Flash.
LLM_PROVIDER="mock"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
