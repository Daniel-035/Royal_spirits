{
  "name": "royal-spirits",
  "version": "1.0.0",
  "private": true,
  "description": "Royal Spirits — online liquor ordering website + admin panel",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "playwright test --config=playwright.config.ts",
    "db:migrate": "pnpm --filter @royal-spirits/api exec prisma migrate dev",
    "db:generate": "pnpm --filter @royal-spirits/api exec prisma generate",
    "db:seed": "pnpm --filter @royal-spirits/api exec tsx prisma/seed.ts",
    "db:studio": "pnpm --filter @royal-spirits/api exec prisma studio",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.49.1",
    "eslint": "^9.15.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0"
  }
}
